{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "node"
    ]
  },
  "include": [
    "core/**/*.ts",
    "server/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "web"
  ]
}
